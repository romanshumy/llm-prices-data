{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.modelpricewatch/mcp",
  "description": "Live LLM API pricing: token prices, model lookups, cheapest-model rankings. Free tier needs no key.",
  "websiteUrl": "https://modelpricewatch.com/api/",
  "repository": {
    "url": "https://github.com/romanshumy/llm-prices-data",
    "source": "github",
    "subfolder": "mcp"
  },
  "version": "1.1.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://modelpricewatch.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@modelpricewatch/mcp",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
